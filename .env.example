# Cloudinary credentials for server-side uploads and MCP tools.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Unsigned upload preset used by the client-side Upload Widget. Not secret,
# but moderation and folder must be configured on the preset itself in the
# Cloudinary console since unsigned uploads can't override them per-request.
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name